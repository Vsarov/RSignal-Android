{
  "name": "signal-desktop",
  "version": "1.5.0",
  "description": "RSignals opportunity scanner for fresh public conversations.",
  "type": "module",
  "main": "main.js",
  "author": "Steve Mordue",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --win dir",
    "build:web": "node scripts/build-web.mjs",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:test": "npm run android:sync && cd android && gradlew.bat testDebugUnitTest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@openai/codex": "0.147.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.signal.scanner",
    "productName": "RSignals",
    "artifactName": "RSignals-Setup-${version}.${ext}",
    "asar": true,
    "asarUnpack": [
      "assets/icon.ico",
      "assets/tray.png"
    ],
    "forceCodeSigning": true,
    "files": [
      "main.js",
      "preload.cjs",
      "server.js",
      "codex-service.js",
      "public/**/*",
      "assets/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@openai/codex-win32-x64/vendor/x86_64-pc-windows-msvc/bin/codex.exe",
        "to": "codex/codex.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "azureSignOptions": {
        "publisherName": "Forceworks, LLC",
        "endpoint": "https://eus.codesigning.azure.net/",
        "certificateProfileName": "rclbc-appsource",
        "codeSigningAccountName": "AppCodeSigning",
        "fileDigest": "SHA256",
        "timestampRfc3161": "http://timestamp.acs.microsoft.com",
        "timestampDigest": "SHA256"
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RSignals",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.0",
    "@capacitor/preferences": "^8.0.1"
  }
}
